#!/usr/bin/env node

const fs = require("fs");
const path = require("path");
const os = require("os");

function warnIfUnsupportedNode() {
  const nodeVersion = process.versions.node || "";
  const majorVersion = Number.parseInt(nodeVersion.split(".")[0], 10);
  if (!Number.isNaN(majorVersion) && majorVersion < 20) {
    console.warn(
      `⚠️  Node.js ${nodeVersion} detected. superpowers-gemini requires Node.js 20+. 20未満は動作保証外です。`,
    );
  }
}

const command = process.argv[2];
const args = process.argv.slice(3);
const arg = args[0];

const homeDir = os.homedir();
const preferredGeminiDir = path.join(homeDir, ".gemini");
const fallbackGeminiDir = path.join(homeDir, ".config", "gemini");
const geminiConfigDir = fs.existsSync(preferredGeminiDir)
  ? preferredGeminiDir
  : fallbackGeminiDir;
const superpowersRepoDir = path.join(geminiConfigDir, "superpowers");
const superpowersSkillsDir = path.join(superpowersRepoDir, "skills");
const personalSkillsDir = path.join(geminiConfigDir, "skills");
const bootstrapFile = path.join(
  superpowersRepoDir,
  ".gemini",
  "superpowers-bootstrap.md",
);

async function main() {
  warnIfUnsupportedNode();
  const skillsCore = await import("../lib/skills-core.js");
  const {
    extractFrontmatter,
    findSkillsInDir,
    resolveSkillPath,
    checkForUpdates,
    stripFrontmatter,
  } = skillsCore;
  const displayPath = (targetPath) =>
    targetPath.startsWith(homeDir)
      ? `~${targetPath.slice(homeDir.length)}`
      : targetPath;
  const resolvedGeminiDir = displayPath(geminiConfigDir);
  const replaceGeminiDirForDir = (content, targetDir) => {
    const resolvedTargetDir = displayPath(targetDir);
    return content
      .replace(/{{GEMINI_CONFIG_DIR}}/g, resolvedTargetDir)
      .replace(/~\/\.gemini/g, resolvedTargetDir);
  };
  const replaceGeminiDir = (content) =>
    replaceGeminiDirForDir(content, geminiConfigDir);

  function printSkill(skillPath, sourceType) {
    const skillFile = path.join(skillPath, "SKILL.md");
    const relPath =
      sourceType === "personal"
        ? path.relative(personalSkillsDir, skillPath)
        : path.relative(superpowersSkillsDir, skillPath);

    if (sourceType === "personal") {
      console.log(relPath.replace(/\\/g, "/"));
    } else {
      console.log(`superpowers:${relPath.replace(/\\/g, "/")}`);
    }

    const { description } = extractFrontmatter(skillFile);
    if (description) console.log(`  ${description}`);
    console.log("");
  }

  function runFindSkills() {
    console.log("Available skills:");
    console.log("==================");
    console.log("");

    const foundSkills = new Set();

    const personalSkills = findSkillsInDir(personalSkillsDir, "personal", 2);
    for (const skill of personalSkills) {
      const relPath = path.relative(personalSkillsDir, skill.path);
      foundSkills.add(relPath);
      printSkill(skill.path, "personal");
    }

    const superpowersSkills = findSkillsInDir(
      superpowersSkillsDir,
      "superpowers",
      1,
    );
    for (const skill of superpowersSkills) {
      const relPath = path.relative(superpowersSkillsDir, skill.path);
      if (!foundSkills.has(relPath)) {
        printSkill(skill.path, "superpowers");
      }
    }

    console.log("Usage:");
    console.log(
      "  superpowers-gemini use-skill <skill-name>   # Load a specific skill",
    );
    console.log("");
    console.log("Skill naming:");
    console.log(
      `  Superpowers skills: superpowers:skill-name (from ${displayPath(superpowersSkillsDir)}/)`,
    );
    console.log(
      `  Personal skills: skill-name (from ${displayPath(personalSkillsDir)}/)`,
    );
    console.log(
      "  Personal skills override superpowers skills when names match.",
    );
    console.log("");
    console.log(
      "Note: All skills are disclosed at session start via bootstrap.",
    );
  }

  function runBootstrap() {
    console.log("# Superpowers Bootstrap for Gemini CLI");
    console.log("# ====================================");
    console.log("");

    if (checkForUpdates(superpowersRepoDir)) {
      console.log("## Update Available");
      console.log("");
      console.log(
        "⚠️  Your superpowers installation is behind the latest version.",
      );
      console.log(
        `To update, run: \`cd ${displayPath(superpowersRepoDir)} && git pull\``,
      );
      console.log("");
      console.log("---");
      console.log("");
    }

    if (fs.existsSync(bootstrapFile)) {
      console.log("## Bootstrap Instructions:");
      console.log("");
      try {
        const content = fs.readFileSync(bootstrapFile, "utf8");
        console.log(replaceGeminiDir(content));
      } catch (error) {
        console.log(`Error reading bootstrap file: ${error.message}`);
      }
      console.log("");
      console.log("---");
      console.log("");
    }

    console.log("## Available Skills:");
    console.log("");
    runFindSkills();

    console.log("");
    console.log("---");
    console.log("");

    console.log("## Auto-loading superpowers:using-superpowers skill:");
    console.log("");
    runUseSkill("superpowers:using-superpowers");

    console.log("");
    console.log("---");
    console.log("");
    console.log("# Bootstrap Complete!");
    console.log("# You now have access to all superpowers skills.");
    console.log(
      '# Use "superpowers-gemini use-skill <skill>" to load and apply skills.',
    );
    console.log(
      "# Remember: If a skill applies to your task, you MUST use it!",
    );
  }

  function updateContextFileNames(
    fileNames = ["GEMINI.md", "AGENTS.md"],
  ) {
    const settingsDir = preferredGeminiDir;
    const settingsFile = path.join(settingsDir, "settings.json");
    const displaySettingsFile = displayPath(settingsFile);

    try {
      fs.mkdirSync(settingsDir, { recursive: true });
    } catch (error) {
      console.log(
        `Failed to create ${displayPath(settingsDir)}: ${error.message}`,
      );
      return;
    }

    let settings = {};
    if (fs.existsSync(settingsFile)) {
      try {
        const rawSettings = fs.readFileSync(settingsFile, "utf8");
        settings = rawSettings.trim() ? JSON.parse(rawSettings) : {};
      } catch (error) {
        console.log(
          `Failed to read ${displaySettingsFile}: ${error.message}`,
        );
        return;
      }
    }

    const existing = settings.context?.fileName;
    const existingList = Array.isArray(existing)
      ? existing
      : existing
        ? [existing]
        : [];
    const merged = [...existingList];
    for (const name of fileNames) {
      if (!merged.includes(name)) {
        merged.push(name);
      }
    }

    settings.context = {
      ...settings.context,
      fileName: merged,
    };

    try {
      fs.writeFileSync(
        settingsFile,
        `${JSON.stringify(settings, null, 2)}\n`,
        "utf8",
      );
      console.log(`Updated ${displaySettingsFile}`);
    } catch (error) {
      console.log(`Failed to update ${displaySettingsFile}: ${error.message}`);
    }
  }

  function runInit(options = {}) {
    let bootstrapContent;
    try {
      bootstrapContent = fs.readFileSync(bootstrapFile, "utf8");
    } catch (error) {
      console.log(`Error reading bootstrap file: ${error.message}`);
      return;
    }

    const targetDirs = [preferredGeminiDir, fallbackGeminiDir];
    const importBlockTemplate = [
      "## Superpowers Bootstrap",
      "",
      "@{{GEMINI_CONFIG_DIR}}/superpowers/.gemini/superpowers-bootstrap.md",
    ].join("\n");
    const legacyBootstrapRegex =
      /<EXTREMELY_IMPORTANT>[\s\S]*?IF A SKILL APPLIES TO YOUR TASK, YOU DO NOT HAVE A CHOICE\. YOU MUST USE IT\.[\s\S]*?<\/EXTREMELY_IMPORTANT>/;
    const bootstrapSectionRegex =
      /^## Superpowers Bootstrap\s*\n[\s\S]*?(?=^##\s|\s*$)/m;

    for (const targetDir of targetDirs) {
      const geminiFile = path.join(targetDir, "GEMINI.md");
      const displayGeminiFile = displayPath(geminiFile);

      try {
        fs.mkdirSync(targetDir, { recursive: true });
      } catch (error) {
        console.log(`Failed to create ${displayGeminiFile}: ${error.message}`);
        continue;
      }

      let existingContent = "";
      if (fs.existsSync(geminiFile)) {
        try {
          existingContent = fs.readFileSync(geminiFile, "utf8");
        } catch (error) {
          console.log(`Failed to read ${displayGeminiFile}: ${error.message}`);
          continue;
        }
      }

      const block = replaceGeminiDirForDir(
        importBlockTemplate,
        targetDir,
      ).trim();
      const normalizedExisting = existingContent.replace(/\r\n/g, "\n");
      const normalizedBlock = block.replace(/\r\n/g, "\n");

      if (normalizedExisting.includes(normalizedBlock)) {
        console.log(
          `Skipped ${displayGeminiFile} (already contains bootstrap)`,
        );
        continue;
      }

      let updatedExisting = normalizedExisting;
      let replacedLegacy = false;
      if (bootstrapSectionRegex.test(normalizedExisting)) {
        updatedExisting = normalizedExisting.replace(
          bootstrapSectionRegex,
          normalizedBlock,
        );
        replacedLegacy = true;
      } else if (legacyBootstrapRegex.test(normalizedExisting)) {
        updatedExisting = normalizedExisting.replace(
          legacyBootstrapRegex,
          normalizedBlock,
        );
        replacedLegacy = true;
      }

      const trimmedExisting = updatedExisting.replace(/\s*$/, "");
      const nextContent = replacedLegacy
        ? `${trimmedExisting}\n`
        : trimmedExisting
          ? `${trimmedExisting}\n\n${block}\n`
          : `${block}\n`;

      try {
        fs.writeFileSync(geminiFile, nextContent, "utf8");
        console.log(`Updated ${displayGeminiFile}`);
      } catch (error) {
        console.log(`Failed to update ${displayGeminiFile}: ${error.message}`);
      }
    }

    if (options.updateSettings) {
      updateContextFileNames();
    }
  }

  function normalizeSkillName(skillName) {
    if (!skillName) return "";
    if (skillName.startsWith("superpowers:")) {
      const stripped = skillName.substring("superpowers:".length);
      if (stripped.startsWith("skills/")) {
        return `superpowers:${stripped.substring("skills/".length)}`;
      }
      return skillName;
    }
    if (skillName.startsWith("skills/")) {
      return skillName.substring("skills/".length);
    }
    return skillName;
  }

  function runUseSkill(skillName) {
    if (!skillName) {
      console.log("Usage: superpowers-gemini use-skill <skill-name>");
      console.log("Examples:");
      console.log(
        "  superpowers-gemini use-skill superpowers:brainstorming  # Load superpowers skill",
      );
      console.log(
        "  superpowers-gemini use-skill brainstorming              # Load personal skill (or superpowers if not found)",
      );
      console.log(
        "  superpowers-gemini use-skill my-custom-skill            # Load personal skill",
      );
      return;
    }

    const normalizedSkillName = normalizeSkillName(skillName);
    const resolved = resolveSkillPath(
      normalizedSkillName,
      superpowersSkillsDir,
      personalSkillsDir,
    );

    if (!resolved) {
      console.log(
        `Error: Skill not found: ${normalizedSkillName.replace(/^superpowers:/, "")}`,
      );
      console.log("");
      console.log("Available skills:");
      runFindSkills();
      return;
    }

    const { skillFile, sourceType, skillPath } = resolved;

    if (sourceType === "personal") {
      console.log(`# Loading personal skill: ${skillPath}`);
    } else {
      console.log(`# Loading superpowers skill: superpowers:${skillPath}`);
    }
    console.log(`# Source: ${displayPath(skillFile)}`);
    console.log("");

    let content;
    let frontmatter;
    try {
      const fullContent = fs.readFileSync(skillFile, "utf8");
      const { name, description } = extractFrontmatter(skillFile);
      content = stripFrontmatter(fullContent);
      frontmatter = { name, description };
    } catch (error) {
      console.log(`Error reading skill file: ${error.message}`);
      return;
    }

    const displayName =
      sourceType === "personal" ? skillPath : `superpowers:${skillPath}`;
    const skillDirectory = path.dirname(skillFile);

    console.log(`# ${frontmatter.name || displayName}`);
    if (frontmatter.description) {
      console.log(`# ${frontmatter.description}`);
    }
    console.log(
      `# Skill-specific tools and reference files live in ${displayPath(skillDirectory)}`,
    );
    console.log("# ============================================");
    console.log("");

    console.log(content);
  }

  function runDoctor() {
    const checks = [];

    const nodeVersion = process.versions.node || "";
    const majorVersion = Number.parseInt(nodeVersion.split(".")[0], 10);
    if (Number.isNaN(majorVersion)) {
      checks.push({
        title: "Node.js バージョン",
        status: "warn",
        detail: "Node.js のバージョンを判定できません。",
        remedy:
          "Node.js 20 以上をインストールし、`node --version` で確認してください。",
      });
    } else if (majorVersion < 20) {
      checks.push({
        title: "Node.js バージョン",
        status: "warn",
        detail: `Node.js ${nodeVersion} を検出しました (推奨: 20+).`,
        remedy:
          "Node.js 20 以上へアップデートしてください。例: `nvm install 20 && nvm use 20`",
      });
    } else {
      checks.push({
        title: "Node.js バージョン",
        status: "ok",
        detail: `Node.js ${nodeVersion} を検出しました。`,
        remedy: "この項目は対応不要です。",
      });
    }

    const preferredExists = fs.existsSync(preferredGeminiDir);
    const fallbackExists = fs.existsSync(fallbackGeminiDir);
    const resolvedDir = preferredExists
      ? preferredGeminiDir
      : fallbackGeminiDir;
    const resolvedLabel = displayPath(resolvedDir);
    let configStatus = "ok";
    let configDetail = `Gemini 設定ディレクトリは ${resolvedLabel} です。`;
    let configRemedy = "この項目は対応不要です。";
    if (!preferredExists && !fallbackExists) {
      configStatus = "fail";
      configDetail =
        "~/.gemini と ~/.config/gemini のどちらも存在しません。";
      configRemedy =
        "どちらかのディレクトリを作成してください。例: `mkdir -p ~/.gemini`";
    } else if (!preferredExists && fallbackExists) {
      configStatus = "warn";
      configDetail = `~/.config/gemini を使用しています (${resolvedLabel})。`;
      configRemedy =
        "~/.gemini を使いたい場合は `mkdir -p ~/.gemini` を実行して移行してください。";
    } else if (preferredExists && fallbackExists) {
      configStatus = "warn";
      configDetail =
        `~/.gemini と ~/.config/gemini の両方が存在します。` +
        ` 現在は ${resolvedLabel} を使用します。`;
      configRemedy =
        "片方のみ使う場合は不要なディレクトリを削除するか内容を統合してください。";
    }

    checks.push({
      title: "Gemini 設定ディレクトリ",
      status: configStatus,
      detail: configDetail,
      remedy: configRemedy,
    });

    if (fs.existsSync(personalSkillsDir)) {
      checks.push({
        title: "Personal skills ディレクトリ",
        status: "ok",
        detail: `${displayPath(personalSkillsDir)} を検出しました。`,
        remedy: "この項目は対応不要です。",
      });
    } else {
      checks.push({
        title: "Personal skills ディレクトリ",
        status: "fail",
        detail: `${displayPath(personalSkillsDir)} が見つかりません。`,
        remedy: `作成してください: mkdir -p ${displayPath(personalSkillsDir)}`,
      });
    }

    if (fs.existsSync(superpowersSkillsDir)) {
      checks.push({
        title: "Superpowers skills ディレクトリ",
        status: "ok",
        detail: `${displayPath(superpowersSkillsDir)} を検出しました。`,
        remedy: "この項目は対応不要です。",
      });
    } else {
      checks.push({
        title: "Superpowers skills ディレクトリ",
        status: "fail",
        detail: `${displayPath(superpowersSkillsDir)} が見つかりません。`,
        remedy:
          `Superpowers リポジトリを配置してください。例: ` +
          `git clone https://github.com/obra/superpowers.git ${displayPath(
            superpowersRepoDir,
          )}`,
      });
    }

    const geminiFile = path.join(resolvedDir, "GEMINI.md");
    const displayGeminiFile = displayPath(geminiFile);
    if (!fs.existsSync(geminiFile)) {
      checks.push({
        title: "GEMINI.md",
        status: "fail",
        detail: `${displayGeminiFile} が見つかりません。`,
        remedy: `作成または更新してください: ${displayPath(
          path.join(superpowersRepoDir, ".gemini", "superpowers-gemini"),
        )} init`,
      });
    } else {
      let geminiContent = "";
      try {
        geminiContent = fs.readFileSync(geminiFile, "utf8");
      } catch (error) {
        checks.push({
          title: "GEMINI.md",
          status: "fail",
          detail: `${displayGeminiFile} を読み取れません: ${error.message}`,
          remedy: "ファイル権限を確認して再試行してください。",
        });
        geminiContent = "";
      }

      if (geminiContent) {
        let bootstrapContent = "";
        try {
          bootstrapContent = fs.readFileSync(bootstrapFile, "utf8");
        } catch (error) {
          checks.push({
            title: "Superpowers ブートストラップ文言",
            status: "fail",
            detail: `ブートストラップファイルを読み取れません: ${error.message}`,
            remedy:
              "superpowers リポジトリが正しく配置されているか確認してください。",
          });
        }

        if (bootstrapContent) {
          const importBlockTemplate = [
            "## Superpowers Bootstrap",
            "",
            "@{{GEMINI_CONFIG_DIR}}/superpowers/.gemini/superpowers-bootstrap.md",
          ].join("\n");
          const expectedBlock = replaceGeminiDirForDir(
            importBlockTemplate,
            resolvedDir,
          ).trim();
          const legacyBlock = replaceGeminiDirForDir(
            bootstrapContent,
            resolvedDir,
          ).trim();
          const legacyBootstrapRegex =
            /<EXTREMELY_IMPORTANT>[\s\S]*?IF A SKILL APPLIES TO YOUR TASK, YOU DO NOT HAVE A CHOICE\. YOU MUST USE IT\.[\s\S]*?<\/EXTREMELY_IMPORTANT>/;
          const bootstrapSectionRegex =
            /^## Superpowers Bootstrap\s*\n[\s\S]*?(?=^##\s|\s*$)/m;
          const normalizedGemini = geminiContent.replace(/\r\n/g, "\n");
          const normalizedBlock = expectedBlock.replace(/\r\n/g, "\n");
          const normalizedLegacy = legacyBlock.replace(/\r\n/g, "\n");
          const hasImport = normalizedGemini.includes(normalizedBlock);
          const hasLegacy =
            !hasImport &&
            (normalizedGemini.includes(normalizedLegacy) ||
              legacyBootstrapRegex.test(normalizedGemini) ||
              bootstrapSectionRegex.test(normalizedGemini));
          checks.push({
            title: "Superpowers ブートストラップ文言",
            status: hasImport ? "ok" : "warn",
            detail: hasImport
              ? "GEMINI.md にブートストラップの @import が含まれています。"
              : hasLegacy
                ? "GEMINI.md に旧形式の貼り付け済みブートストラップがあります。"
                : "GEMINI.md にブートストラップ文言が見つかりません。",
            remedy: hasImport
              ? "この項目は対応不要です。"
              : `${displayPath(
                  path.join(superpowersRepoDir, ".gemini", "superpowers-gemini"),
                )} init を実行して差し替えてください。`,
          });
        }
      }
    }

    let execStatus = "ok";
    let execDetail = `${displayPath(__filename)} は実行可能です。`;
    let execRemedy = "この項目は対応不要です。";
    try {
      fs.accessSync(__filename, fs.constants.X_OK);
    } catch (error) {
      execStatus = "fail";
      execDetail = `${displayPath(__filename)} に実行権限がありません。`;
      execRemedy = `実行権限を付与してください: chmod +x ${displayPath(
        __filename,
      )}`;
    }

    checks.push({
      title: "superpowers-gemini 実行権限",
      status: execStatus,
      detail: execDetail,
      remedy: execRemedy,
    });

    const statusIcon = (status) => {
      switch (status) {
        case "ok":
          return "✅";
        case "warn":
          return "⚠️";
        case "fail":
          return "❌";
        default:
          return "•";
      }
    };

    console.log("Superpowers Doctor");
    console.log("==================");
    console.log("");
    for (const check of checks) {
      console.log(`${statusIcon(check.status)} ${check.title}`);
      console.log(`  状態: ${check.detail}`);
      console.log(`  対処: ${check.remedy}`);
      console.log("");
    }
  }

  switch (command) {
    case "bootstrap":
      runBootstrap();
      break;
    case "init":
    case "install":
      runInit({
        updateSettings:
          args.includes("--update-settings") ||
          args.includes("--context-file-names"),
      });
      break;
    case "use-skill":
      runUseSkill(arg);
      break;
    case "find-skills":
      runFindSkills();
      break;
    case "doctor":
      runDoctor();
      break;
    default:
      console.log("Superpowers for Gemini CLI");
      console.log("Usage:");
      console.log(
        "  superpowers-gemini bootstrap              # Run complete bootstrap with all skills",
      );
      console.log(
        "  superpowers-gemini init                   # Update GEMINI.md files with bootstrap content",
      );
      console.log(
        "  superpowers-gemini init --update-settings # Add context.fileName to settings.json",
      );
      console.log(
        "  superpowers-gemini init --context-file-names # Alias for --update-settings",
      );
      console.log(
        "  superpowers-gemini install                # Alias for init",
      );
      console.log(
        "  superpowers-gemini use-skill <skill-name> # Load a specific skill",
      );
      console.log(
        "  superpowers-gemini find-skills            # List all available skills",
      );
      console.log(
        "  superpowers-gemini doctor                 # Diagnose installation status",
      );
      console.log("");
      console.log("Examples:");
      console.log("  superpowers-gemini bootstrap");
      console.log("  superpowers-gemini init");
      console.log("  superpowers-gemini use-skill superpowers:brainstorming");
      console.log("  superpowers-gemini use-skill my-custom-skill");
      console.log("  superpowers-gemini doctor");
      break;
  }
}

main();
